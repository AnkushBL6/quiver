{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quiver",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "publisher": "Quiver contributors",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
