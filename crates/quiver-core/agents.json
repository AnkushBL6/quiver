      ],
      "projectDir": ".agents/skills",
      "readDirs": [
        "{CODEX_HOME}/skills"
      ],
      "note": "Codex reads ~/.agents/skills (user) and $CODEX_HOME/skills (legacy).",
      "tier": 1,
      "detectBins": [
        "codex"
      ],
      "apps": [
        "Codex.app",
        "ChatGPT.app"
