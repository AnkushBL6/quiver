{
  "$comment": "Quiver agent registry. Paths: ~ = home, {XDG_CONFIG} = $XDG_CONFIG_HOME or ~/.config, {VAR} = env var override with default. globalDirs[0] is the preferred install dir; others are legacy/alternate dirs that are also scanned. Sourced from vercel-labs/skills v1.7.4 and verified against installed agent binaries (Nov 2026). PRs welcome!",
  "agents": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "globalDirs": [
        "~/.claude/skills"
      ],
      "detect": [
        "~/.claude"
      ],
      "projectDir": ".claude/skills",
      "tier": 1,
      "detectBins": [
        "claude"
      ],
      "apps": [
        "Claude.app"
      ]
    },
    {
      "id": "codex",
      "name": "Codex",
      "globalDirs": [
        "~/.agents/skills"
